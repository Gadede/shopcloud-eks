# ── Node.js ───────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── React build output ────────────────────────
services/frontend/build/

# ── Environment variables (never commit these) ─
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ── Terraform ─────────────────────────────────
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfstate.lock.info
.terraform.lock.hcl
tfplan
override.tf
override.tf.json

# ── Docker ────────────────────────────────────
.dockerignore

# ── AWS credentials (critical — never commit) ─
.aws/
credentials

# ── VS Code ───────────────────────────────────
.vscode/
*.code-workspace

# ── OS files ──────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────
logs/
*.log

# ── Misc ──────────────────────────────────────
.cache/
dist/
tmp/